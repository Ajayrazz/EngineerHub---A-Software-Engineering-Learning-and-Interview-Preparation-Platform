# EngineerHub — environment variable catalog.
# LOCAL DEVELOPMENT VALUES ONLY. These are fake and publicly visible; NEVER reuse them anywhere real.
# `make dev-env` copies this file to .env (git-ignored) if .env does not exist.

# Host ports published on 127.0.0.1 (change if they clash with something already on your machine)
POSTGRES_HOST_PORT=5440
REDIS_HOST_PORT=6380

# --- PostgreSQL (one server, separate databases/users per concern; see docs/08 §5) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=dev-only-superuser-pw
APP_DB_NAME=engineerhub
APP_DB_USER=engineerhub_app
APP_DB_PASSWORD=dev-only-app-pw
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=dev-only-keycloak-db-pw

# --- Redis ---
REDIS_PASSWORD=dev-only-redis-pw

# --- RabbitMQ ---
RABBITMQ_USER=engineerhub
RABBITMQ_PASSWORD=dev-only-rabbit-pw
RABBITMQ_VHOST=engineerhub
# Non-local environments must also set RABBITMQ_HOST (and RABBITMQ_PORT, RABBITMQ_SSL=true): the API refuses to
# start without explicit host + credentials, never uses the 'guest' account, and allows plain TCP only to localhost.

# --- Keycloak / OIDC (self-hosted; realm "engineerhub" imported from infra/keycloak/realm) ---
KEYCLOAK_BOOTSTRAP_ADMIN_USER=kcadmin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=dev-only-kc-admin-pw
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/engineerhub
KEYCLOAK_BFF_CLIENT_ID=engineerhub-web
KEYCLOAK_BFF_CLIENT_SECRET=dev-only-bff-client-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- API runtime configuration (the 'local' profile derives DB settings from the APP_DB_* values above) ---
# Non-local environments must set these explicitly; the API refuses to start without them:
#   DB_URL=jdbc:postgresql://<host>:5432/<db>   DB_USER=...   DB_PASSWORD=...
#   KEYCLOAK_ISSUER_URI=https://<idp>/realms/engineerhub   (required)
#   JWT_AUDIENCE=engineerhub-api                           (default)
#   CORS_ALLOWED_ORIGINS=                                  (comma-separated exact origins; empty = no CORS)

# --- Web / BFF (Next.js server-side only; none of these reach the browser) ---
# Public origin of the web app. https:// is required outside localhost (enables Secure + __Host- cookies).
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8080
# Redis holds the server-side sessions (tokens are AES-256-GCM encrypted at rest). Matches REDIS_PASSWORD/REDIS_HOST_PORT above.
REDIS_URL=redis://:dev-only-redis-pw@localhost:6380
# >= 32 chars. Derives the session encryption + key-MAC keys. Changing it logs everyone out.
SESSION_SECRET=dev-only-session-secret-change-me-32bytes+
# Optional (defaults shown): sliding idle timeout and absolute lifetime of a BFF session, in seconds.
# SESSION_IDLE_TTL_SECONDS=604800
# SESSION_ABSOLUTE_TTL_SECONDS=2592000

# --- Object storage (any S3-compatible provider; RustFS locally) ---
STORAGE_PROVIDER=s3compatible
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=dev-only-access-key
S3_SECRET_KEY=dev-only-secret-key-12345
S3_BUCKET_MEDIA=engineerhub-media
S3_BUCKET_TESTDATA=engineerhub-testdata
S3_PATH_STYLE=true

# --- Email (Mailpit locally: SMTP :1025, web UI http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Payments (TEST mode only until the Live Readiness Gate passes; see docs/21) ---
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe intentionally absent in v1 (Razorpay only; provider-abstracted for later)
# Tax mode is set in the admin console (UNCONFIGURED -> DISABLED|ENABLED) after accountant confirmation.
# Do NOT put fabricated legal/seller data here; live seller details are entered via admin only.
BILLING_INVOICE_PREFIX=EH

# --- Judge ---
JUDGE_DEV_UNSAFE=false   # true only on a dev machine; weak sandbox, NOT for untrusted code
JUDGE_ENABLED_LANGUAGES=java,python,cpp
JUDGE_MAX_SOURCE_BYTES=65536
JUDGE_MAX_CONCURRENT_PER_USER=2
JUDGE_ISOLATE_BIN=/usr/local/bin/isolate

# --- AI (server-side only; never expose to browser) ---
AI_SERVICE_URL=http://localhost:8000
LLM_API_KEY=
AI_MONTHLY_BUDGET_USD=0
