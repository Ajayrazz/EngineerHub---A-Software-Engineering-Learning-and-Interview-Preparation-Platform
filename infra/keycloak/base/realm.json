{
  "realm": "engineerhub",
  "displayName": "EngineerHub",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(10) and notUsername and notEmail",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 7776000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "SUPER_ADMIN",
        "description": "Platform owner; all permissions",
        "composite": true,
        "composites": {
          "realm": [
            "STAFF_MFA"
          ]
        }
      },
      {
        "name": "ADMIN",
        "description": "Administrator",
        "composite": true,
        "composites": {
          "realm": [
            "STAFF_MFA"
          ]
        }
      },
      {
        "name": "CONTENT_MANAGER",
        "description": "Manages and publishes content",
        "composite": true,
        "composites": {
          "realm": [
            "STAFF_MFA"
          ]
        }
      },
      {
        "name": "PROBLEM_SETTER",
        "description": "Authors problems and test cases",
        "composite": true,
        "composites": {
          "realm": [
            "STAFF_MFA"
          ]
        }
      },
      {
        "name": "MODERATOR",
        "description": "Moderates community content",
        "composite": true,
        "composites": {
          "realm": [
            "STAFF_MFA"
          ]
        }
      },
      {
        "name": "INSTRUCTOR",
        "description": "Authors assigned courses",
        "composite": true,
        "composites": {
          "realm": [
            "STAFF_MFA"
          ]
        }
      },
      {
        "name": "STAFF_MFA",
        "description": "Marker included in every staff role: its holders must use TOTP at login. Never assign directly; the API ignores it."
      }
    ]
  },
  "clients": [
    {
      "clientId": "engineerhub-web",
      "name": "EngineerHub web (Next.js BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${APP_URL}/auth/callback"
      ],
      "webOrigins": [
        "${APP_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APP_URL}/",
        "access.token.lifespan": "300"
      },
      "protocolMappers": [
        {
          "name": "engineerhub-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "engineerhub-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "engineerhub-admin-svc",
      "name": "Backend role management (service account; client_credentials only)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "attributes": {
        "access.token.lifespan": "300",
        "client_credentials.use_refresh_token": "true"
      },
      "defaultClientScopes": [
        "kc-admin-api",
        "roles",
        "basic"
      ]
    }
  ],
  "smtpServer": {
    "host": "${SMTP_HOST}",
    "port": "${SMTP_PORT}",
    "from": "${SMTP_FROM}",
    "fromDisplayName": "EngineerHub",
    "auth": "true",
    "user": "${SMTP_USER}",
    "password": "${SMTP_PASSWORD}",
    "ssl": "false",
    "starttls": "true"
  },
  "authenticationFlows": [
    {
      "alias": "browser-staff-mfa",
      "description": "Browser login; holders of STAFF_MFA must also pass TOTP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10
        },
        {
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 25
        },
        {
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "browser-staff-mfa forms"
        }
      ]
    },
    {
      "alias": "browser-staff-mfa forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10
        },
        {
          "userSetupAllowed": false,
          "autheticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "browser-staff-mfa otp"
        }
      ]
    },
    {
      "alias": "browser-staff-mfa otp",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "conditional-user-role",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorConfig": "staff-requires-mfa"
        },
        {
          "userSetupAllowed": false,
          "autheticatorFlow": false,
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "staff-requires-mfa",
      "config": {
        "condUserRole": "STAFF_MFA",
        "negate": "false"
      }
    }
  ],
  "browserFlow": "browser-staff-mfa",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "users": [
    {
      "username": "service-account-engineerhub-admin-svc",
      "enabled": true,
      "serviceAccountClientId": "engineerhub-admin-svc",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users",
          "view-realm"
        ]
      }
    }
  ]
}
